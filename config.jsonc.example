{
  "version": "1.5.2",
  "server_port": 5102,
  "exchange_rate": {
    "USD_TO_CNY": 7.2
  },
  "enable_ipv6": true,
  // Web 管理面板的访问密码
  "web_access_key": "YOUR_PASSWORD_HERE",
  // 可信反向代理 IP 列表（部署在 nginx/Cloudflare Tunnel 等反代后时填写，
  // 登录限流会按 X-Forwarded-For 解析真实客户端 IP，避免所有访客被计到同一个代理 IP 上互相误伤；
  // 直连部署保持空数组即可）
  "trusted_proxies": [],
  // LMArena 会话 ID（留空则不集成 LMArena）
  "session_id": "",
  "id_updater_last_mode": "battle",
  "id_updater_battle_target": "B",
  "id_updater_auto_save_mode": "model",
  "enable_auto_retry": false,
  "retry_timeout_seconds": 60,
  "empty_response_retry": {
    "enabled": false,
    "max_retries": 5,
    "base_delay_ms": 100,
    "max_delay_ms": 3000,
    "show_retry_info_to_client": true
  },
  "bypass_enabled": false,
  "image_optimization": {
    "enabled": true,
    "strip_metadata": true,
    "convert_to_webp": true,
    "webp_quality": 70,
    "max_width": 4096,
    "max_height": 4096
  },
  "force_stream_flush": true,
  "stream_response_timeout_seconds": 3000,
  "api_call_timeout_seconds": 3000,
  "first_chunk_timeout_seconds": 600,
  "max_concurrent_downloads": 20,
  "connection_pool": {
    "total_limit": 200,
    "per_host_limit": 128
  },
  "memory_management": {
    "gc_threshold_mb": 80,
    "image_cache_max_size": 100,
    "image_cache_ttl_seconds": 600
  },
  "enable_lmarena_reasoning": true,
  "reasoning_output_mode": "openai",
  "preserve_streaming": true,
  // 模型自动归档：按“最后调用时间”自动归档长期未使用的模型（归档后不出现在
  // /v1/models 列表、无法被请求调用，管理面板折叠展示，可手动恢复）
  // enabled: 是否启用；days: 超过多少天未调用则归档；run_on_startup: 服务启动时立即扫描一次
  "auto_archive": {
    "enabled": false,
    "days": 30,
    "run_on_startup": false
  },
  // DeepSeek 官方 logprobs 蒸馏采集：命中 api_base_hosts 且模型名匹配时，
  // 自动给上游 /chat/completions 注入 logprobs=true、top_logprobs=20，并把
  // reasoning/content 两路 token 分布落成 raw + normalized JSONL。
  "deepseek_logprobs": {
    "enabled": true,
    "output_dir": "data/deepseek-logprobs",
    "api_base_hosts": ["api.deepseek.com"],
    "top_logprobs": 20,
    "force_logprobs": true,
    "force_top_logprobs": true,
    "strip_logprobs_from_client": true,
    "record_raw_stream": true,
    "write_normalized": true,
    "redact_image_data": true,
    "require_logprobs_to_write": true,
    "compress": true
  },
  // Tokenizer 配置：为每个模型指定使用的 tokenizer 类型
  // 支持: anthropic / google / deepseek / tiktoken / custom_xxx
  "tokenizer_config": {
    "YOUR_MODEL_NAME": "anthropic"
  }
}
